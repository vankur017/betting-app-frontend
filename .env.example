# Copy to .env.local and adjust. Never put secrets in VITE_* variables: they are shipped to the browser.

# Working product name. Final branding is still an open decision.
VITE_APP_NAME=Mintline

# Leave empty to call the API on the same origin (/api), which the dev server proxies.
# Deployed site (Vercel) with the backend on your own computer: set this in the Vercel project's
# Environment Variables to http://localhost:5000, then redeploy. It is read at build time.
VITE_API_BASE_URL=

# Number of decimal places in one virtual coin. Must match the backend's smallest-unit rule.
VITE_COIN_DECIMALS=2

# Address shown on the Help page for bug and abuse reports.
VITE_SUPPORT_EMAIL=

# Sign-in is off for now: everyone plays as a guest and /login, /register redirect to the lobby.
# Set to true once the backend supports sessions.
VITE_AUTH_ENABLED=false

# Dev server only: where /api requests are proxied.
VITE_DEV_API_PROXY_TARGET=http://localhost:5000
